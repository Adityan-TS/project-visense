// Copy this file to Secrets.xcconfig (same folder) and fill in the two values.
// Secrets.xcconfig is git-ignored. Then: xcodegen generate, and Run in Xcode.
//
// DATABRICKS_TOKEN: Databricks -> your profile -> Settings -> Developer ->
//                   Access tokens -> Generate (starts with dapi)
// DATABRICKS_WAREHOUSE_ID: SQL Warehouses -> your warehouse -> Connection details
//                   -> the last part of "HTTP path" (/sql/1.0/warehouses/<THIS>)
DATABRICKS_TOKEN =
DATABRICKS_WAREHOUSE_ID =
